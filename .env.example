# PostgreSQL connection for Drizzle & Vercel
# Examples:
# Neon / Supabase: postgresql://USER:PASSWORD@ep-xyz.region.neon.tech/neondb?sslmode=require
# Local development: postgresql://postgres:postgres@localhost:5432/electricity_bills
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require

# Optional pool configuration for serverless functions (default: 10)
# PG_MAX_CONNECTIONS=10

# Optional private workbook location (on Vercel, /tmp is used automatically if omitted)
# EXCEL_FILE_PATH=/tmp/electricity_bill_records.xlsx
